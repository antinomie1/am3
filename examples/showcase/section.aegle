// A titled section whose content wraps in a row, centered or top-aligned.
component Section(title: string) {
    Column {
        gap: 12dp
        MdText { text: title; typescale: title_medium }
        Row { gap: 12dp; wrap: wrap; align: center; slot }
    }
}

component TopSection(title: string) {
    Column {
        gap: 12dp
        MdText { text: title; typescale: title_medium }
        Row { gap: 12dp; wrap: wrap; align: start; slot }
    }
}
